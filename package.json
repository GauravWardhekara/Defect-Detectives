{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "cap:android": "npm run build && cap sync android && cap open android",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && electron-builder -w"
  },
  "build": {
    "appId": "com.defecttracker.app",
    "productName": "Defect Tracker",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.svg"
    }
  },
  "dependencies": {
    "@azure/msal-browser": "^5.20.0",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/core": "^8.5.0",
    "@google/genai": "^2.19.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@ionic/pwa-elements": "^3.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "5.2.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.546.0",
    "motion": "12.43.0",
    "papaparse": "^5.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "uuid": "^14.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@types/express": "4.17.25",
    "@types/node": "22.20.1",
    "@types/papaparse": "^5.5.2",
    "autoprefixer": "10.5.4",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "express": "^5.2.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^9.1.0"
  }
}
